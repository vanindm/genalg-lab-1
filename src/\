double f (const std::array<int32_t, 8> &x) {
    double res = (x[0] - 1) * (x[0] - 1);
    for (int i = 2; i < 8; ++i) {
        res += i * (2 * x[i] * x[i] - x[i - 1]) * (2 * x[i] * x[i] - x[i - 1]);
    }
    return res;
}

